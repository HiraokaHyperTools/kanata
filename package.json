{
  "name": "kanata",
  "version": "3.3.7-3",
  "description": "Kanata a fork of Honoka which is a Bootstrap theme.",
  "author": "Logue",
  "website": "http://logue.github.io/Kanata",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run clean && vite build",
    "preview": "vite preview",
    "test": "stylelint \"scss/**/*.scss\" \"src/scss/**/*.scss\"",
    "lint": "stylelint \"scss/**/*.scss\" \"src/scss/**/*.scss\"",
    "clean": "rimraf dist",
    "copy-assets": "node scripts/copy-assets.js",
    "package": "npm run build && npm run compress",
    "compress": "node scripts/compress.js",
    "serve": "npm run dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/logue/Kanata.git"
  },
  "devDependencies": {
    "@vitejs/plugin-legacy": "^5.0.0",
    "archiver": "^7.0.0",
    "autoprefixer": "^10.4.5",
    "glob": "^10.0.0",
    "lightningcss": "^1.30.1",
    "postcss": "^8.4.31",
    "rimraf": "^5.0.0",
    "sass": "^1.90.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard-scss": "^13.0.0",
    "stylelint-scss": "^6.0.0",
    "terser": "^5.43.1",
    "vite": "^5.0.0"
  }
}
